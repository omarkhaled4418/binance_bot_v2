# ──────────────────────────────────────────────────────────
# Binance Sell Bot – Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────

# ── Live Binance API credentials ──
BINANCE_API_KEY=your_live_api_key_here
BINANCE_API_SECRET=your_live_api_secret_here

# ── Testnet credentials (free at testnet.binance.vision) ──
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ── Flask secret key (any random string is fine) ──
FLASK_SECRET_KEY=change_me_to_something_random

